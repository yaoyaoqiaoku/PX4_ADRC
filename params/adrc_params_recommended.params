# ADRC 推荐参数（基于26轮真机扫参验证）
# QGC 导入：设置 → 参数 → 工具 → Load from file
#
# 验证结果：CW=10 ESO_W=40 TAU=0.035 LZ3=2 AF=0
#   Roll 振动 5.4°/s（PID 优秀水平 5~8°/s）
#   Pitch 振动 5.0°/s
#   z3 扰动估计 std=1.0（全部配置中最干净）
#
# CW=10 是机架天花板：CW=12~13 触发 Roll 结构共振，CW=14 Yaw 爆炸，CW=20 失控

# 模式
ADRC_ESO_MODE	1
ADRC_CTRL_LAW	2

# Roll
ADRC_ROLL_CW	10.0
ADRC_ROLL_ESO_W	40.0
ADRC_ROLL_B0	100.0
ADRC_ROLL_TAU	0.035
ADRC_ROLL_GAMMA	0.7
ADRC_ROLL_FLT	30.0
ADRC_ROLL_Z3MAX	0.0
ADRC_ROLL_LZ3	2.0
ADRC_ROLL_AF	0.0
ADRC_ROLL_KI	0.0
ADRC_ROLL_FF	0.0
ADRC_ROLL_RAMP	0.0
ADRC_ROLL_NF	0.0
ADRC_ROLL_NBW	1.0
ADRC_ROLL_SPS	0.0
ADRC_ROLL_ILIM	0.5
ADRC_ROLL_NB1	10.0
ADRC_ROLL_NB2	0.0009
ADRC_ROLL_A1	0.9
ADRC_ROLL_A2	1.5
ADRC_ROLL_R	100.0
ADRC_ROLL_DELTA	0.015
ADRC_ROLL_B01	150.0
ADRC_ROLL_B02	250.0
ADRC_ROLL_B03	550.0
ADRC_ROLL_UMN	-1.0
ADRC_ROLL_UMX	1.0

# Pitch（与 Roll 相同）
ADRC_PITCH_CW	10.0
ADRC_PITCH_ESO_W	40.0
ADRC_PITCH_B0	100.0
ADRC_PITCH_TAU	0.035
ADRC_PITCH_GAMMA	0.7
ADRC_PITCH_FLT	30.0
ADRC_PITCH_Z3MAX	0.0
ADRC_PITCH_LZ3	2.0
ADRC_PITCH_AF	0.0
ADRC_PITCH_KI	0.0
ADRC_PITCH_FF	0.0
ADRC_PITCH_RAMP	0.0
ADRC_PITCH_NF	0.0
ADRC_PITCH_NBW	1.0
ADRC_PITCH_SPS	0.0
ADRC_PITCH_ILIM	0.5
ADRC_PITCH_NB1	10.0
ADRC_PITCH_NB2	0.0009
ADRC_PITCH_A1	0.9
ADRC_PITCH_A2	1.5
ADRC_PITCH_R	100.0
ADRC_PITCH_DELTA	0.015
ADRC_PITCH_B01	150.0
ADRC_PITCH_B02	250.0
ADRC_PITCH_B03	550.0
ADRC_PITCH_UMN	-1.0
ADRC_PITCH_UMX	1.0

# Yaw（保持保守）
ADRC_YAW_CW	5.0
ADRC_YAW_ESO_W	15.0
ADRC_YAW_B0	20.0
ADRC_YAW_TAU	0.01
ADRC_YAW_GAMMA	0.6
ADRC_YAW_FLT	20.0
ADRC_YAW_Z3MAX	0.0
ADRC_YAW_LZ3	0.0
ADRC_YAW_AF	0.0
ADRC_YAW_KI	0.0
ADRC_YAW_FF	0.0
ADRC_YAW_RAMP	0.0
ADRC_YAW_NF	0.0
ADRC_YAW_NBW	1.0
ADRC_YAW_SPS	0.0
ADRC_YAW_ILIM	0.5
ADRC_YAW_NB1	5.0
ADRC_YAW_NB2	0.0004
ADRC_YAW_A1	0.9
ADRC_YAW_A2	1.5
ADRC_YAW_R	50.0
ADRC_YAW_DELTA	0.015
ADRC_YAW_B01	80.0
ADRC_YAW_B02	120.0
ADRC_YAW_B03	200.0
ADRC_YAW_UMN	-1.0
ADRC_YAW_UMX	1.0

# 姿态环
MC_ROLL_P	4.5
MC_PITCH_P	4.5
MC_YAW_P	4.0
MC_AIRMODE	0
